{
  "name": "flagbearer/flagbearer",
  "description": "Feature flags for PHP and Laravel: checked locally, with gradual rollouts, from Flagbearer.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "gradual-rollouts",
    "flagbearer",
    "laravel"
  ],
  "homepage": "https://flagbearer.dev",
  "support": {
    "docs": "https://docs.flagbearer.dev/sdks/php",
    "issues": "https://github.com/flagbearer-dev/php-sdk/issues",
    "source": "https://github.com/flagbearer-dev/php-sdk"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Flagbearer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flagbearer\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
